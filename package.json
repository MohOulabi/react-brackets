{
  "name": "react-brackets-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "examples/*",
    "apps/*"
  ],
  "scripts": {
    "examples": "vite examples",
    "build": "bun run --filter './packages/*' build",
    "test": "bun run --filter './packages/*' test",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check:packages": "bun run --filter './packages/*' check:package",
    "check:size": "bun scripts/check-size.ts",
    "changeset": "changeset",
    "release": "bun run build && bun run check:publish && changeset publish",
    "check:publish": "bun scripts/assert-publishable.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@changesets/cli": "^3.0.3",
    "@types/bun": "^1.4.4",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
