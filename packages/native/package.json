{
  "name": "@react-brackets/native",
  "version": "0.3.1",
  "description": "Tournament brackets for React Native and Expo: single and double elimination, round robin and Swiss, swiped and zoomed on the UI thread.",
  "license": "MIT",
  "author": "Mohammed AlOulabi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MohOulabi/react-brackets.git",
    "directory": "packages/native"
  },
  "homepage": "https://react-brackets.oulabi.dev",
  "keywords": [
    "react-native",
    "expo",
    "bracket",
    "tournament",
    "tournament-bracket",
    "react-native-bracket",
    "single-elimination",
    "double-elimination",
    "round-robin",
    "swiss",
    "esports",
    "reanimated",
    "gesture-handler",
    "ios",
    "android"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "!**/__tests__"
  ],
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bob build",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check:package": "publint"
  },
  "dependencies": {
    "@react-brackets/core": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-gesture-handler": ">=3.0.0",
    "react-native-reanimated": ">=4.0.0",
    "react-native-worklets": ">=0.5.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "~19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-worklets": "0.13.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
