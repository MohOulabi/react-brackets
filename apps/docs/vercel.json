{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run build && cd apps/docs && bun run build",
  "ignoreCommand": "[ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "redirects": [
    {
      "source": "/docs/guides/custom-match",
      "destination": "/docs/customize/match-cards",
      "permanent": true
    }
  ]
}
